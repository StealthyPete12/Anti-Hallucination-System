{
  "title": "Phase 5: RAG Observability",
  "uid": "rag-phase5-observability",
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Mean Cost (USD)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 5 }, "overrides": [] },
      "targets": [
        {
          "rawSql": "SELECT AVG(cost_usd) AS mean_cost_usd FROM request_metrics WHERE created_at > NOW() - INTERVAL '24 hours';",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "P95 Latency (ms)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS p95_latency_ms FROM request_metrics WHERE created_at > NOW() - INTERVAL '24 hours';",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Feedback Volume (24h)",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS feedback_volume FROM feedback WHERE created_at > NOW() - INTERVAL '24 hours';",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Thumbs Up %",
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT ROUND(100.0 * SUM(CASE WHEN rating > 0 THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0), 1) AS thumbs_up_pct FROM feedback WHERE created_at > NOW() - INTERVAL '24 hours';",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Thumbs Down %",
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT ROUND(100.0 * SUM(CASE WHEN rating < 0 THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0), 1) AS thumbs_down_pct FROM feedback WHERE created_at > NOW() - INTERVAL '24 hours';",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency vs. Feedback Rating (correlation)",
      "description": "Answers the README's Phase 5 trace-correlation question: does a thumbs-down cluster with higher latency? Each point is one traced request, joined to its feedback (if any) by trace_id.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "rawSql": "SELECT m.created_at AS time, m.latency_ms, COALESCE(f.rating::text, 'no feedback') AS rating FROM request_metrics m LEFT JOIN feedback f ON f.trace_id = m.trace_id WHERE m.created_at > NOW() - INTERVAL '24 hours' ORDER BY m.created_at;",
          "format": "time_series",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_POSTGRES",
        "type": "datasource",
        "query": "postgres",
        "current": {}
      }
    ]
  }
}
