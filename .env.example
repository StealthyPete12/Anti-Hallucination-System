# Copy to .env and fill in. All settings are optional overrides of the
# defaults in config.py; every key is prefixed RAG_ and matches a Settings
# field name (upper-cased).

# LiteLLM model string, e.g. "gpt-4o-mini", "anthropic/claude-sonnet-5",
# "ollama/llama3". The provider's own API key env var (OPENAI_API_KEY,
# ANTHROPIC_API_KEY, ...) must also be set - LiteLLM reads those directly,
# not through the RAG_ prefix.
RAG_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Qdrant connection (docker-compose default shown)
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION_NAME=postgres_docs

# Retrieval / chunking
RAG_TOP_K=5
RAG_CHUNK_SIZE_TOKENS=512
RAG_CHUNK_OVERLAP_RATIO=0.15

# Phase 4: hybrid retrieval. RAG_RETRIEVAL_MODE is one of dense|sparse|hybrid.
# sparse/hybrid require the Qdrant collection to carry a sparse vector too
# (created automatically - see rag/stores/qdrant.py).
RAG_RETRIEVAL_MODE=dense
RAG_RRF_K=60
RAG_RETRIEVAL_FANOUT=20

# Phase 4: cross-encoder reranking (Query -> top RAG_RETRIEVAL_FANOUT ->
# reranker -> top RAG_TOP_K -> generator). RAG_RERANKER_MODEL also accepts
# "BAAI/bge-reranker-base".
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Phase 4: optional query rewriting before retrieval (generator still always
# sees the user's original question).
RAG_QUERY_REWRITE_ENABLED=false
RAG_QUERY_REWRITE_MODEL=gpt-4o-mini

RAG_LOG_LEVEL=INFO

# Phase 5: observability. docker-compose.yml sets RAG_OTEL_ENABLED=true and
# points these at its own phoenix/postgres services automatically - only set
# these yourself when running the API outside docker compose (see README's
# "Phase 5: Observability" section for both paths).
RAG_OTEL_ENABLED=false
RAG_OTEL_SERVICE_NAME=anti-hallucination-rag
RAG_PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
RAG_POSTGRES_DSN=postgresql+psycopg://rag:rag@localhost:5432/rag_observability
RAG_METRICS_WINDOW_SIZE=100
